[Unit]
Description=Forma incident monitor and admin alert dispatcher
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=forma
Group=forma
WorkingDirectory=/opt/forma
EnvironmentFile=/etc/forma/control.env
ExecStart=/opt/forma/.venv/bin/python /opt/forma/monitoring_worker.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/forma/.forma
[Install]
WantedBy=multi-user.target
