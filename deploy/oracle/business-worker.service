[Unit]
Description=Forma business agent worker
After=network-online.target forma.service
Wants=network-online.target
[Service]
Type=simple
User=forma
Group=forma
WorkingDirectory=/opt/forma
EnvironmentFile=/etc/forma/control.env
ExecStart=/opt/forma/.venv/bin/python /opt/forma/business_worker.py --config /opt/forma/.forma/business-worker.json
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/forma/.forma
[Install]
WantedBy=multi-user.target
